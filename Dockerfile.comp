FROM python:3.11-slim

WORKDIR /app

# Contest image only: OpenCV 5 and boto3 for POST /analyze/shot s3_key.
# The live ai-football-coach service must keep using Dockerfile, which
# installs requirements-deploy.txt. See docs/deploy_aws.md.
COPY requirements-comp.txt .
RUN pip install --no-cache-dir -r requirements-comp.txt

COPY . .

# Apache-2.0 MoveNet Lightning. Not committed; fetched while the image builds
# so shot.pose_model_present is true. Needs network. See docs/deploy_aws.md.
# Does not set AIFC_ALLOW_MP_FALLBACK.
RUN python scripts/fetch_movenet_lightning.py \
    && test -s models/pose/movenet_lightning.onnx

ENV PORT=8000
EXPOSE 8000

CMD uvicorn services.api.app:app --host 0.0.0.0 --port ${PORT:-8000}
